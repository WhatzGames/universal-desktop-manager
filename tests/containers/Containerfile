FROM docker.io/library/rust:bookworm as build

WORKDIR /app

COPY rust-toolchain.toml ./
RUN rustc --version

COPY Cargo.toml Cargo.lock ./
COPY src ./src

RUN cargo build --release --locked

FROM scratch as artifact
COPY --from=build \
    /app/target/release/universal-desktop-manager \
    /udm